{% extends "base.html" %}
{% block title %}ISP Profile Report{% endblock %}
{% block page_title %}ISP Profile Report{% endblock %}

{% block back_button %}
<a href="{{ url_for('isp_dashboard') }}"
   class="btn btn-sm btn-secondary">
  ← Back
</a>
{% endblock %}

{% block content %}

<!-- Student header -->
<div class="card" style="margin-bottom:1.25rem">

  <div style="display:flex;
              align-items:center;
              gap:14px">

    <div style="width:48px;
                height:48px;
                border-radius:50%;
                background:#f1f5f9;
                display:flex;
                align-items:center;
                justify-content:center;
                font-size:1.6rem">

      ☪️

    </div>

    <div>

      <div style="font-size:1rem;
                  font-weight:700;
                  color:#0f172a">

        {{ student.name }}

      </div>

      <div style="font-size:.75rem;
                  color:#64748b;
                  margin-top:3px">

        {{ student.grade }} {{ student.section }}

      </div>

    </div>

  </div>

</div>


<!-- Overview -->
<div class="card" style="margin-bottom:1.25rem">

  <h3 style="font-size:.95rem;
             font-weight:700;
             margin-bottom:1rem">

    📊 ISP Profile Overview

  </h3>


  <div style="display:grid;
              grid-template-columns:
              repeat(auto-fill,minmax(280px,1fr));
              gap:1rem">

    {% for attr, emoji, descs in isp_profile %}

    {% set item = ratings.get(attr, {}) %}

    <div style="background:#f8fafc;
                border:1px solid #e2e8f0;
                border-radius:10px;
                padding:1rem">

      <!-- Attribute -->
      <div style="display:flex;
                  align-items:flex-start;
                  gap:10px;
                  margin-bottom:.75rem">

        <span style="font-size:1.5rem">
          {{ emoji }}
        </span>

        <div>

          <div style="font-size:.88rem;
                      font-weight:700;
                      color:#0f172a">

            {{ attr }}

          </div>

          {% for desc in descs %}
          <div style="font-size:.7rem;
                      color:#64748b;
                      line-height:1.4;
                      margin-top:2px">

            {{ desc }}

          </div>
          {% endfor %}

        </div>

      </div>


      <!-- Ratings -->
      <div style="display:grid;
                  grid-template-columns:1fr 1fr;
                  gap:8px">

        <div style="background:#fff;
                    border:1px solid #e2e8f0;
                    border-radius:8px;
                    padding:8px">

          <div style="font-size:.65rem;
                      color:#64748b;
                      margin-bottom:3px">

            Teacher

          </div>

          {% if item.get('teacher') %}

          {% set tr = item.get('teacher') %}

          <div style="font-size:.85rem;
                      font-weight:700;
                      color:{{ isp_rating_colors[tr] }}">

            {{ tr }}/4

          </div>

          <div style="font-size:.65rem;
                      color:#64748b">

            {{ isp_rating_scale[tr] }}

          </div>

          {% else %}

          <div style="font-size:.75rem;
                      color:#94a3b8">

            Not rated

          </div>

          {% endif %}

        </div>


        <div style="background:#fff;
                    border:1px solid #e2e8f0;
                    border-radius:8px;
                    padding:8px">

          <div style="font-size:.65rem;
                      color:#64748b;
                      margin-bottom:3px">

            Student

          </div>

          {% if item.get('student') %}

          {% set sr = item.get('student') %}

          <div style="font-size:.85rem;
                      font-weight:700;
                      color:{{ isp_rating_colors[sr] }}">

            {{ sr }}/4

          </div>

          <div style="font-size:.65rem;
                      color:#64748b">

            {{ isp_rating_scale[sr] }}

          </div>

          {% else %}

          <div style="font-size:.75rem;
                      color:#94a3b8">

            Not completed

          </div>

          {% endif %}

        </div>

      </div>


      <!-- Reflection -->
      {% if item.get('reflection') %}

      <div style="margin-top:.75rem;
                  padding:.7rem;
                  background:#fff;
                  border-left:3px solid #6366f1;
                  border-radius:4px">

        <div style="font-size:.65rem;
                    font-weight:700;
                    color:#64748b;
                    margin-bottom:3px">

          Student Reflection

        </div>

        <div style="font-size:.75rem;
                    color:#374151;
                    line-height:1.45">

          {{ item.get('reflection') }}

        </div>

      </div>

      {% endif %}

    </div>

    {% endfor %}

  </div>

</div>


<!-- Legend -->
<div class="card">

  <h3 style="font-size:.9rem;
             font-weight:700;
             margin-bottom:.75rem">

    Rating Scale

  </h3>

  <div style="display:flex;
              gap:8px;
              flex-wrap:wrap">

    {% for val, label in isp_rating_scale.items() %}

    <div style="padding:7px 12px;
                border-radius:8px;
                border:2px solid {{ isp_rating_colors[val] }};
                background:{{ isp_rating_colors[val] }}22;
                color:{{ isp_rating_colors[val] }};
                font-size:.72rem;
                font-weight:600">

      {{ val }} — {{ label }}

    </div>

    {% endfor %}

  </div>

</div>

{% endblock %}
